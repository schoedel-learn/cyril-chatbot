{
  "entities": {
    "Parish": {
      "title": "Parish",
      "description": "Parish subscription and location",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Parish name" },
        "address": { "type": "string", "description": "Physical address" },
        "placeId": { "type": "string", "description": "Google Maps Place ID, if applicable" },
        "lat": { "type": "number", "description": "Latitude" },
        "lng": { "type": "number", "description": "Longitude" },
        "adminIds": { "type": "array", "description": "UIDs of parish admins"}
      },
      "required": ["name", "address"]
    },
    "User": {
      "title": "User",
      "description": "User profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email" },
        "role": { "type": "string", "description": "User role (e.g., admin)" },
        "firstName": { "type": "string", "description": "First name" },
        "lastName": { "type": "string", "description": "Last name" },
        "parishName": { "type": "string", "description": "Parish name" },
        "parishId": { "type": "string", "description": "Parish ID for multi-tenant linking" },
        "phone": { "type": "string", "description": "Phone number (optional)" },
        "diocese": { "type": "string", "description": "Diocese" },
        "otherDiocese": { "type": "string", "description": "Other diocese (optional)" },
        "profileCompleted": { "type": "boolean", "description": "Whether profile is complete" }
      },
      "required": ["uid", "email"]
    },
    "KnowledgeDocument": {
      "title": "Knowledge Document",
      "description": "A document providing specific info for OCIA",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Document title" },
        "content": { "type": "string", "description": "Document text content" },
        "instructions": { "type": "string", "description": "Specific instructions for the AI on how to use this document" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "authorUid": { "type": "string", "description": "UID of the user who uploaded it" }
      },
      "required": ["title", "content", "createdAt", "authorUid"]
    },
    "ChatSession": {
      "title": "Chat Session",
      "description": "A saved conversation session",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Chat title" },
        "createdAt": { "type": "number", "description": "Creation timestamp" },
        "messages": { "type": "array", "description": "List of messages" }
      },
      "required": ["userId", "title", "createdAt"]
    },
    "UserMemory": {
      "title": "User Memory",
      "description": "AI's memory of the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner UID" },
        "notes": { "type": "string", "description": "Memory notes" },
        "updatedAt": { "type": "number", "description": "Last update timestamp" }
      },
      "required": ["userId", "notes", "updatedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback on AI responses",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "UID of the user who submitted feedback" },
        "userEmail": { "type": "string", "description": "Email of the user who submitted feedback" },
        "prompt": { "type": "string", "description": "The prompt that generated the response" },
        "response": { "type": "string", "description": "The AI response" },
        "rating": { "type": "string", "description": "The rating given by the user (up or down)" },
        "comment": { "type": "string", "description": "The user's comment" },
        "createdAt": { "type": "number", "description": "Creation timestamp" }
      },
      "required": ["userId", "userEmail", "response", "createdAt"]
    }
  },
  "firestore": {
    "/parishes/{parishId}": {
      "schema": { "$ref": "Parish" },
      "description": "Parish subscriptions and locations"
    },
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profile"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "ChatSession" },
      "description": "Chat sessions for the user"
    },
    "/users/{userId}/memory/current": {
      "schema": { "$ref": "UserMemory" },
      "description": "AI memory about the user"
    },
    "/knowledge_base/{docId}": {
      "schema": { "$ref": "KnowledgeDocument" },
      "description": "Knowledge base documents for OCIA"
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "Feedback" },
      "description": "User feedback on AI responses"
    }
  }
}
