rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields:
    //   - uid: string (required, immutable) - Firebase Auth UID
    //   - email: string (required, immutable) - User email
    //   - role: string (optional) - User role (e.g., admin)
    //   - firstName: string (optional)
    //   - lastName: string (optional)
    //   - parishName: string (optional)
    //   - phone: string (optional)
    //   - diocese: string (optional)
    //   - otherDiocese: string (optional)
    //   - profileCompleted: boolean (optional)
    //
    // Collection: knowledge_base
    // Document ID: docId
    // Fields:
    //   - title: string (required)
    //   - content: string (required)
    //   - instructions: string (optional)
    //   - createdAt: number (required, immutable)
    //   - authorUid: string (required, immutable)
    // Collection: feedback
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required, immutable)
    //   - userEmail: string (required, immutable)
    //   - prompt: string (optional, immutable)
    //   - response: string (required, immutable)
    //   - rating: string (optional, immutable)
    //   - comment: string (optional, immutable)
    //   - createdAt: number (required, immutable)
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null && (request.auth.token.email == "schoedelb@gmail.com" || request.auth.token.email == "barry@schoedel.design");
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "schoedelb@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidKnowledgeDoc() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'content', 'createdAt', 'authorUid']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 900000 &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 10000)) &&
             data.createdAt is number &&
             data.authorUid == request.auth.uid;
    }

    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             (!('role' in data) || data.role in ['admin', 'user', 'General', 'Catechist', 'Sponsor', 'Candidate', 'OCIA leader', 'Priest', 'Deacon']) &&
             (!('firstName' in data) || data.firstName is string) &&
             (!('lastName' in data) || data.lastName is string) &&
             (!('parishName' in data) || data.parishName is string) &&
             (!('parishId' in data) || data.parishId is string) &&
             (!('phone' in data) || data.phone is string) &&
             (!('diocese' in data) || data.diocese is string) &&
             (!('otherDiocese' in data) || data.otherDiocese is string) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool);
    }

    function isValidFeedback() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'userEmail', 'response', 'createdAt']) &&
             data.userId == request.auth.uid &&
             (data.userEmail == request.auth.token.email || (data.userEmail == '' && !('email' in request.auth.token))) &&
             data.response is string && data.response.size() > 0 && data.response.size() <= 100000 &&
             (!('prompt' in data) || (data.prompt is string && data.prompt.size() <= 100000)) &&
             (!('rating' in data) || data.rating in ['up', 'down']) &&
             (!('comment' in data) || (data.comment is string && data.comment.size() <= 10000)) &&
             data.createdAt is number;
    }

    function isValidChat() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'title', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.createdAt is number &&
             (!('messages' in data) || data.messages is list);
    }

    function isValidUserMemory() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'notes', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.notes is string &&
             data.updatedAt is number;
    }

    function isValidParish() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'address']) &&
             data.name is string && data.name.size() > 0 &&
             data.address is string && data.address.size() > 0 &&
             (!('placeId' in data) || data.placeId is string) &&
             (!('lat' in data) || data.lat is number) &&
             (!('lng' in data) || data.lng is number) &&
             (!('adminIds' in data) || data.adminIds is list);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /parishes/{parishId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidParish();
      allow update: if isAuthenticated() && isValidParish() && (isAdmin() || (resource.data.adminIds != null && request.auth.uid in resource.data.adminIds));
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can only create their own document if they are the owner
      allow create: if isOwner(userId) &&
                       isValidUser() &&
                       request.resource.data.email == request.auth.token.email &&
                       (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isAdmin());
                       
      // Users can update their own profile
      allow update: if isOwner(userId) &&
                       isValidUser() &&
                       request.resource.data.uid == resource.data.uid &&
                       (!('role' in request.resource.data) || request.resource.data.role != 'admin' || request.resource.data.role == resource.data.role || isAdmin());

      match /chats/{chatId} {
        allow read, write: if isOwner(userId) && isValidChat();
      }

      match /memory/current {
        allow read, write: if isOwner(userId) && isValidUserMemory();
      }
    }

    match /knowledge_base/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidKnowledgeDoc();
      allow update: if isAdmin() && isValidKnowledgeDoc() &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.authorUid == resource.data.authorUid;
      allow delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidFeedback();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
